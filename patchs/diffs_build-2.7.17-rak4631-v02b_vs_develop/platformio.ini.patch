+board = rak4631
+framework = arduino
+lib_deps = 
+    adafruit/Adafruit LIS3DH
+build_flags = 
+	-I rakwireless/variants/rak4630
+	; -I src
+    -D RAK4631
+    -D USE_LIS3DH_SENSOR
+    -D USE_LIS3DH_SENSOR2
+;     -I variants/rak4631

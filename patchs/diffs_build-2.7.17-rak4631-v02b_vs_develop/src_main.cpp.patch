+    //     lis3dhInit = true;
+    // }
+    // }
+    // if (seismic) seismic->handle();  // un seul appel vers le module
+    seismic->handle();  // un seul appel vers le module
+#endif
+
+    
 #ifdef ARCH_ESP32
     esp32Loop();

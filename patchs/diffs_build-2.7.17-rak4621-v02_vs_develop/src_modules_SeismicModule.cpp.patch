+// SeismicModule.cpp
+
+#include "SeismicModule.h"
+#include "configuration.h"
+#include <Wire.h>
+
+#include "../mesh/generated/meshtastic/mesh.pb.h"      // MeshPacket, Data, Telemetry...
+#include "../mesh/generated/meshtastic/telemetry.pb.h"  // si Telemetry/Motion sont dans un proto séparé
+
+// static constexpr uint8_t LIS3DH_ADDR = 0x18;
+
+SeismicModule::SeismicModule(MeshService &service)
+    : m_service(service),
+      m_lastSeismic(0),
+      m_tolerance(0.15f),
+      m_xPrev(0.0f),
+      m_yPrev(0.0f),
+      m_zPrev(0.0f)
+{
+}
+
+void SeismicModule::begin()
+{
+#if defined(USE_LIS3DH_SENSOR)
+    // Si l’IMU est déjà initialisée ailleurs, tu peux laisser vide.
+    // Sinon, mettre ici la config RAK1904/LIS3DH.
+#endif
+}
+
+void SeismicModule::handle()
+{
+#if defined(USE_LIS3DH_SENSOR)
+    // SEISMIC RAK1904 DIFFÉRENTIELLE 250ms
+    if (millis() - m_lastSeismic > 100) {  // ou 250 ms selon ton choix
+
+        Wire.beginTransmission(LIS3DH_ADDR);
+        Wire.write(0x28 | 0x80);
+        Wire.endTransmission(false);
+        Wire.requestFrom(LIS3DH_ADDR, (uint8_t)6);
+
+        if (Wire.available() == 6) {
+            float x = (int16_t)(Wire.read() | (Wire.read() << 8)) / 16384.0f;
+            float y = (int16_t)(Wire.read() | (Wire.read() << 8)) / 16384.0f;
+            float z = (int16_t)(Wire.read() | (Wire.read() << 8)) / 16384.0f;
+
+            float dx = (x - m_xPrev) / 0.25f;  // Δg / 0.25s = g/s
+            float dy = (y - m_yPrev) / 0.25f;
+            float dz = (z - m_zPrev) / 0.25f;
+
+            if (dx >= m_tolerance || dy >= m_tolerance || dz >= m_tolerance) {
+                // envoi telemetry.motion + logs
+                sendTelemetryMotion(dx, dy, dz, x, y, z);
+            }
+
+            m_xPrev = x;
+            m_yPrev = y;
+            m_zPrev = z;
+        }
+
+        m_lastSeismic = millis();
+    }
+#endif
+}
+
+void SeismicModule::sendTelemetryMotion(float dx, float dy, float dz,
+                                        float x, float y, float z)
+{
+    // 1) Allouer le paquet comme dans EnvironmentTelemetry
+    meshtastic_MeshPacket *p = m_service.allocDataPacket();   // <<< REMPLACER PAR LA MÊME FONCTION QUE EnvironmentTelemetry
+    if (!p) return;
+
+    meshtastic_Data *data = &p->decoded;
+
+    // 2) Indiquer que le payload est de type Telemetry
+    data->which_payloadVariant = meshtastic_Data_telemetry_tag;
+
+    // 3) Initialiser une struct Telemetry locale
+    meshtastic_Telemetry telemetry = meshtastic_Telemetry_init_default; // ou _init_zero selon ce que tu vois
+
+    // 4) Remplir le sous-champ motion (si défini dans telemetry.proto)
+    telemetry.has_motion = true;
+    telemetry.motion.dx = dx;
+    telemetry.motion.dy = dy;
+    telemetry.motion.dz = dz;
+
+    // 5) Copier la struct Telemetry dans data->payloadVariant.telemetry
+    data->payloadVariant.telemetry = telemetry;
+
+    // 6) Indiquer le portnum TELEMETRY_APP
+    data->portnum = meshtastic_PortNum_TELEMETRY_APP;
+
+    // 7) Envoyer le paquet
+    m_service.sendToMesh(p);
+
+    // 8) Logs texte pour debug
+    char msg[64];
+    snprintf(msg, sizeof(msg),
+             "[SEISMIC] %.3f:%.3f:%.3f|%.1f:%.1f:%.1f",
+             x, y, z, dx, dy, dz);
+    printf("%s\n", msg);
+    LOG_INFO("%s", msg);
+}
